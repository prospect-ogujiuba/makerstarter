{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": { "contentSize": "720px", "wideSize": "1200px" },
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "canvas", "name": "Canvas", "color": "#f6f7f4" },
        { "slug": "surface", "name": "Surface", "color": "#ffffff" },
        { "slug": "ink", "name": "Ink", "color": "#16211d" },
        { "slug": "muted", "name": "Muted", "color": "#5d6a64" },
        { "slug": "accent", "name": "Accent", "color": "#176b4d" },
        { "slug": "highlight", "name": "Highlight", "color": "#dff5e9" },
        { "slug": "border", "name": "Border", "color": "#d7dcd8" }
      ]
    },
    "spacing": { "units": ["px", "rem", "vw", "%"], "spacingSizes": [
      { "slug": "20", "name": "2XS", "size": ".5rem" }, { "slug": "30", "name": "XS", "size": ".75rem" },
      { "slug": "40", "name": "S", "size": "1rem" }, { "slug": "50", "name": "M", "size": "clamp(1.5rem, 3vw, 2rem)" },
      { "slug": "60", "name": "L", "size": "clamp(2.5rem, 6vw, 5rem)" }, { "slug": "70", "name": "XL", "size": "clamp(4rem, 9vw, 8rem)" }
    ] },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        { "slug": "sans", "name": "Sans", "fontFamily": "Inter, ui-sans-serif, system-ui, sans-serif" },
        { "slug": "display", "name": "Display", "fontFamily": "Georgia, 'Times New Roman', serif" }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": ".875rem" }, { "slug": "medium", "name": "Medium", "size": "1rem" },
        { "slug": "large", "name": "Large", "size": "1.25rem" }, { "slug": "x-large", "name": "Extra Large", "size": "clamp(2.4rem, 6vw, 5.5rem)" }
      ]
    },
    "custom": {
      "radius": { "small": ".5rem", "medium": "1rem", "large": "1.5rem", "pill": "999px" },
      "focus": { "color": "var(--wp--preset--color--accent)", "offset": "3px", "width": "2px" },
      "layout": { "content": "720px", "wide": "1200px" }
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--canvas)", "text": "var(--wp--preset--color--ink)" },
    "spacing": { "blockGap": "var(--wp--preset--spacing--50)", "padding": { "left": "var(--wp--preset--spacing--40)", "right": "var(--wp--preset--spacing--40)" } },
    "typography": { "fontFamily": "var(--wp--preset--font-family--sans)", "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.65" },
    "elements": {
      "heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "500", "lineHeight": "1.08" } },
      "link": { "color": { "text": "var(--wp--preset--color--accent)" } },
      "button": { "border": { "radius": "999px" }, "color": { "background": "var(--wp--preset--color--accent)", "text": "var(--wp--preset--color--surface)" }, "typography": { "fontWeight": "700" } }
    },
    "blocks": {
      "core/navigation": { "typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "600" } },
      "core/post-title": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
      "core/separator": { "color": { "background": "var(--wp--preset--color--border)" } }
    }
  },
  "templateParts": [ { "name": "header", "title": "Header", "area": "header" }, { "name": "footer", "title": "Footer", "area": "footer" } ]
}
